# Supabase Configuration
# Get these values from your Supabase project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: key for signing session cookies (at least 32 characters).
# Derived from the service role key if not set.
# SESSION_SECRET=

# Optional: disable creating new trees (default: allowed)
# ALLOW_REGISTRATION=false

# Optional: number of own reverse proxies in front of the app (default 1 = one nginx; 0 = none)
# TRUSTED_PROXIES=1

# Optional: Application Environment
NODE_ENV=development
