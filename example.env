# Supabase Configuration
# Get these values from your Supabase project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Schlüssel für die Sitzungs-Cookies (mind. 32 Zeichen).
# Ohne wird er aus dem Service-Role-Key abgeleitet.
# SESSION_SECRET=

# Optional: Application Environment
NODE_ENV=development
