# Supabase: address and service role key. Only the server uses them; browsers never
# talk to Supabase. Self-hosted on the same host: http://host.docker.internal:8000
# (see docs/supabase.md). Supabase cloud: https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: key for signing session cookies (at least 32 characters).
# Derived from the service role key if not set.
# SESSION_SECRET=

# Optional: let anyone sign up with a tree of their own (default: off; people join by invitation)
# ALLOW_REGISTRATION=true

# Optional: outgoing mail for invitations, password resets and email verification.
# Without it, the admin page shows these links to pass on by hand. See docs/accounts.md.
# MAIL_ENABLED=true
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tree@example.org
# SMTP_PASSWORD=
# MAIL_FROM="Family tree <tree@example.org>"
# Public address of the app; links in mails always use it
# APP_URL=https://tree.example.org
# New accounts confirm their address before signing in (only with mail)
# REQUIRE_EMAIL_VERIFICATION=true

# Optional: number of own reverse proxies in front of the app (default 1 = one nginx; 0 = none)
# TRUSTED_PROXIES=1

# Optional: Application Environment
NODE_ENV=development
