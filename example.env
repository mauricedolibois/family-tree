# Supabase Configuration
# Get these values from your Supabase project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Schlüssel für die Sitzungs-Cookies (mind. 32 Zeichen).
# Ohne wird er aus dem Service-Role-Key abgeleitet.
# SESSION_SECRET=

# Optional: Anlegen neuer Stammbäume abschalten (Standard: erlaubt)
# ALLOW_REGISTRATION=false

# Optional: Anzahl eigener Reverse-Proxys vor der App (Standard 1 = ein nginx; 0 = ohne Proxy)
# TRUSTED_PROXIES=1

# Optional: Application Environment
NODE_ENV=development
